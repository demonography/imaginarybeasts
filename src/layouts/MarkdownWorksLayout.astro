---
import BaseLayout from "./Layout.astro";
const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={frontmatter.title}>
  <section class="page-work">
    <div class="work-info">
      <div>
        <img
          class="work-img"
          src={frontmatter.image.url}
          alt={frontmatter.image.alt}
        />
      </div>
      <div>
        <h1>{frontmatter.title}</h1>
        <slot />
      </div>
    </div>
    <div class="full-width">
      <div class="works-img-container">
      <img
        class="work-img"
        src={frontmatter.worksImage1.url}
        alt={frontmatter.worksImage1.alt}
      />
      <div class="img-caption">{frontmatter.worksImage1caption}</div>
      </div>
      <div class="works-img-container">
      <img
        class="work-img"
        src={frontmatter.worksImage2.url}
        alt={frontmatter.worksImage2.alt}
      />
       <div class="img-caption">{frontmatter.worksImage2caption}</div>
      </div>
           <div class="works-img-container">
      <img
        class="work-img"
        src={frontmatter.worksImage3.url}
        alt={frontmatter.worksImage3.alt}
      />
       <div class="img-caption">{frontmatter.worksImage3caption}</div>
      </div>
            <div class="works-img-container">
      <img
        class="work-img"
        src={frontmatter.worksImage4.url}
        alt={frontmatter.worksImage4.alt}
      />
       <div class="img-caption">{frontmatter.worksImage4caption}</div>
      </div>
    </div>
  </section>
</BaseLayout>
